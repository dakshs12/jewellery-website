# ==============================================================================
# ANAYAS JEWELS — PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# Add these in Vercel / Netlify / Production Server Environment Settings
# ==============================================================================

# 1. Base Domain Configuration
NEXT_PUBLIC_SITE_URL=https://anayasjewels.com

# 2. Sanity CMS (Headless Content & Studio)
# Project ID and Dataset for content queries & /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=ayc6nn5v
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Sanity Write Token with 'Editor' or 'Administrator' rights (from sanity.io/manage)
SANITY_API_WRITE_TOKEN=
# Optional webhook secret for securing custom dispatch webhooks
SANITY_WEBHOOK_SECRET=

# 3. Razorpay Payment Gateway (Live Mode)
# For Live website: Generate Live Key ID (rzp_live_...) & Secret from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# 4. Transactional Emails (Resend)
# API Key from https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Sender email. Once domain anayasjewels.com is DNS verified in Resend, use:
RESEND_FROM_EMAIL=orders@anayasjewels.com
# Replies go directly to customer support inbox
RESEND_REPLY_TO=anayasjewels9@gmail.com
# Admin address receiving live order notifications
ADMIN_NOTIFICATION_EMAIL=info@anayasjewels.com
ADMIN_ALERT_EMAIL=anayasjewels9@gmail.com
